# Copy to ".env" and edit. Everything is optional.
HOST=127.0.0.1          # 0.0.0.0 lets phones on your Wi-Fi open the site (http://YOUR-PC-IP:8000)
PORT=8000
ADMIN_EMAIL=owner@salon.local
ADMIN_PASSWORD=         # leave empty to generate a random one on first run (printed + saved in data/)
SECURE_COOKIES=0        # set to 1 when the site is served over HTTPS
TZ_OFFSET_HOURS=4       # Dubai (UTC+4)
MAX_UPLOAD_MB=5
REMINDER_HOURS=24       # in-app/SMS reminder this long before a confirmed appointment

# SMS via Twilio (leave blank = in-app notifications only; nothing breaks)
SMS_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=971

# SMTP - sends the Forgot Password / reset emails (leave blank = reset emails are not
# sent, the site keeps working and the same generic message is shown)
SMTP_HOST=                # e.g. smtp.gmail.com, smtp.pythonanywhere.com, smtp.office365.com
SMTP_PORT=587             # 587 = STARTTLS below, 465 = implicit SSL (set SMTP_USE_TLS=0)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=                # sender address; defaults to SMTP_USERNAME when blank
SMTP_USE_TLS=1

# Public origin of the live site (optional - used to build reset links, e.g.
# https://yourname.pythonanywhere.com). Leave blank and the link uses the request host.
PUBLIC_BASE_URL=
RESET_TTL_MINUTES=60      # how long a reset link stays valid

# Placeholder for a future payment gateway (none is connected)
PAYMENT_GATEWAY=none
